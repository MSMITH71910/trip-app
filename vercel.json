{
  "version": 2,
  "builds": [
    {
      "src": "trip_planner/wsgi.py",
      "use": "@vercel/python",
      "config": {
        "maxLambdaSize": "15mb"
      }
    }
  ],
  "routes": [
    {
      "src": "/static/(.*)",
      "dest": "/static/$1"
    },
    {
      "src": "/(.*)",
      "dest": "trip_planner/wsgi.py"
    }
  ],
  "buildCommand": "python manage.py migrate --noinput && python manage.py collectstatic --noinput"
}
